{
  "name": "json-smart-viewer",
  "displayName": "JSON Smart Viewer",
  "description": "An interactive, collapsible tree viewer for JSON files.",
  "version": "0.0.1",
  "publisher": "mashurr",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/mashurr/json-smart-viewer.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onLanguage:json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "json-smart-viewer.show",
        "title": "JSON Smart View"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceLangId == json",
          "command": "json-smart-viewer.show",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.90.0",
    "eslint": "^9.25.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "license": "MIT"
}
