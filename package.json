{
  "name": "json-smart-viewer",
  "displayName": "JSON Smart Viewer",
  "description": "Explore big or messy JSON as a tree, table or graph, linked to your editor. Fast on files of hundreds of MB.",
  "version": "0.1.0",
  "publisher": "mashurr",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/mashurr/json-smart-viewer.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "json",
    "viewer",
    "json viewer",
    "tree",
    "table",
    "graph",
    "large files",
    "jsonl",
    "jsonc",
    "explorer"
  ],
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:jsonc",
    "onLanguage:jsonl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "json-smart-viewer.show",
        "title": "JSON Smart View"
      },
      {
        "command": "json-smart-viewer.showSelection",
        "title": "Open Selection in JSON Smart View"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceLangId =~ /^(json|jsonc|jsonl)$/ || resourceExtname =~ /^\\.(jsonl|ndjson)$/",
          "command": "json-smart-viewer.show",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceExtname =~ /^\\.(json|jsonc|jsonl|ndjson)$/",
          "command": "json-smart-viewer.show",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "when": "editorHasSelection",
          "command": "json-smart-viewer.showSelection",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "json-smart-viewer.showSelection",
          "when": "editorHasSelection"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production",
    "compile": "npm run typecheck && node esbuild.mjs",
    "typecheck": "tsc -p . && tsc -p webview",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint src webview"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.25.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "license": "MIT"
}
